# Copy this file to .env and fill in your own values. Never commit .env.

# ---------- LLM (pick one provider) ----------
# anthropic = Claude API (needs ANTHROPIC_API_KEY)
# bedrock   = Claude on Amazon Bedrock (needs AWS credentials, see README)
# deepseek  = DeepSeek API (needs DEEPSEEK_API_KEY)
LLM_PROVIDER=anthropic

# Claude API key, created in the Claude Console (platform.claude.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Only for LLM_PROVIDER=deepseek. Key from platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Only for LLM_PROVIDER=bedrock. Credentials can also come from `aws configure`.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-sonnet-5-5
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---------- GitHub (only needed for `publish`) ----------
# Fine-grained personal access token with "Issues: Read and write" on GITHUB_REPO
GITHUB_TOKEN=
# Repository that receives the issues, written as owner/name
GITHUB_REPO=

# ---------- Bee ----------
# Optional: full path to the bee executable if `bee` is not on PATH
# (Windows example: C:\Users\<you>\AppData\Roaming\npm\bee.cmd)
BEE_BIN=
